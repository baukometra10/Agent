# Application
APP_NAME=Evolve
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=7000
SECRET_KEY=change-me-in-production

# Database — prefer PostgreSQL + pgvector (docker compose up -d db).
# start.ps1 auto-starts Postgres when Docker is available; otherwise SQLite fallback.
DATABASE_URL=postgresql+asyncpg://evolve:evolve@127.0.0.1:5432/evolve
DATABASE_URL_SYNC=postgresql://evolve:evolve@127.0.0.1:5432/evolve
# DATABASE_URL=sqlite+aiosqlite:///./data/evolve.db
# DATABASE_URL_SYNC=sqlite:///./data/evolve.db

# Storage
WORKSPACES_ROOT=./data/workspaces
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=evolve

# Model Gateway — leave keys empty for offline simulate mode
DEFAULT_REASONING_MODEL=openai/gpt-4.1
DEFAULT_CODING_MODEL=openai/gpt-4.1
DEFAULT_FAST_MODEL=openai/gpt-4.1-mini
DEFAULT_MULTIMODAL_MODEL=openai/gpt-4.1
DEFAULT_EMBEDDING_MODEL=openai/text-embedding-3-small
DEFAULT_CRITIC_MODEL=anthropic/claude-sonnet-4-5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# TEACHER_UPSTREAM=openrouter
# Cursor Cloud Agents (optional coding teacher) — Dashboard → API Keys
# CURSOR_API_KEY=
# TEACHER_UPSTREAM=cursor
# CURSOR_DEFAULT_REPO_URL=https://github.com/org/repo
# CURSOR_POLL_TIMEOUT_SECONDS=180
# Railway/cloud: put blank projects under WORKSPACES_ROOT
# CLOUD_WORKSPACES=true
# MODEL_GATEWAY_FORCE_SIMULATE=true

# Ownership — Local First (Teacher → Student)
PREFER_INTERNAL=true
PREFER_PROMOTED_INTERNAL=true
PROMOTED_NO_ESCALATE=true
FAST_HANDOFF_ENABLED=true
AUTO_RETIRE_READY_TEACHERS=true
LORA_REAL_TRAIN_ENABLED=false
LORA_REAL_TRAIN_MAX_STEPS=30
LORA_REAL_TRAIN_TINY_FALLBACK=true
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_ON_URGENT_ONLY=false
SUPER_ADMIN_EMAIL=admin@evolve.admin
INTERNAL_CONFIDENCE_THRESHOLD=0.55
INTERNAL_MODEL_BASE_URL=
INTERNAL_MODEL_NAME=
INTERNAL_MODEL_API_KEY=
INTERNAL_EVAL_MODEL_NAME=
INTERNAL_EVAL_MAX_TOKENS=256
INTERNAL_EVAL_TIMEOUT_SECONDS=120
MODEL_CACHE_ENABLED=true
MODEL_CACHE_TTL_SECONDS=3600
DISTILLATION_ENABLED=true
# DISTILLATION_DATA_ROOT=./data/distillation
# EVAL_MIN_STUDENT_SCORE=0.55
# EVAL_TEACHER_PARITY_RATIO=0.9
LORA_MIN_EXAMPLES=3
LORA_RANK=8
LORA_REAL_TRAIN_ENABLED=false
# Model Factory — eval pass proposes; human approve ships
FACTORY_REQUIRE_HUMAN_APPROVAL=true
FACTORY_REGRESSION_TOLERANCE=0.02

# Chief Agent pool
CHIEF_ENABLED=true
CHIEF_MIN_WORKERS=3
CHIEF_MAX_WORKERS=12
CHIEF_DISTILL_OUTCOMES=true

# Deploy adapters
DEPLOY_PROVIDER=simulate
AZURE_DEPLOY_ENABLED=false
# AZURE_RESOURCE_GROUP=
# AZURE_CONTAINER_APP_NAME=

# Isolation / Safety
ALLOW_UNTRUSTED_CODE_EXECUTION=false
SANDBOX_NETWORK_DISABLED=true

# Continuous Evolution (Phase 11 stubs)
EVOLUTION_CRON_ENABLED=false
NOTIFICATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:7000
